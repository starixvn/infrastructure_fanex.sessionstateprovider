<Project>
    <PropertyGroup>
        <Authors>R&amp;D Team</Authors>
        <Company>Nexcel Solutions</Company>
        <Copyright>2021 Nexdev</Copyright>
        <PackageProjectUrl>https://gitlab.nexdev.net/infrastructure/fanex.sessionstateprovider</PackageProjectUrl>
        <RepositoryUrl>https://gitlab.nexdev.net/infrastructure/fanex.sessionstateprovider</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReleaseNotes>https://gitlab.nexdev.net/infrastructure/fanex.sessionstateprovider/CHANGELOG.md</PackageReleaseNotes>
        <PackageIconUrl>https://gitlab.nexdev.net/uploads/-/system/project/avatar/100/new-idea.png</PackageIconUrl>
        <DefaultLanguage>en-US</DefaultLanguage>
        <LangVersion>latest</LangVersion>
        <IncludeSymbols>false</IncludeSymbols>
        <Version>0.0.1-beta2</Version>
    </PropertyGroup>
    <PropertyGroup>
        <NoWarn>AD0001</NoWarn>
        <Features>IOperation</Features>
        <CodeAnalysisRuleSet>$(SolutionDir)\.sonarlint\Fanex.SessionStateProviderCSharp.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="SonarAnalyzer.CSharp" Version="8.20.0.28934">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.321">
            <PrivateAssets>All</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="$(SolutionDir)\.sonarlint\fanex.sessionstateprovider\CSharp\SonarLint.xml" Link="SonarLint.xml" />
    </ItemGroup>
</Project>